{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limi",
  "version": "0.1.0",
  "identifier": "app.limi.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Limi",
        "width": 76,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Limi",
    "category": "Productivity",
    "shortDescription": "AI usage limits at a glance",
    "longDescription": "A small desktop widget that shows your Claude Code and Codex usage limits and when they reset.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0RDYxREJCMTU5Mzg3NTQKUldSVWg1TVZ1eDNXSklEdEJaZGtISWJyTXRPVDB1VzEva3dzaW14UkJpTHhqNFN0eUI2YVp6a3gK",
      "endpoints": [
        "https://github.com/mark-juswa/Limi/releases/latest/download/latest.json"
      ]
    }
  }
}
